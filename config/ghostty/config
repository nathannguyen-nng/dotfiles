font-family = "JetBrains Mono Regular"
font-family-bold = "JetBrains Mono SemiBold"
font-family-italic = "JetBrains Mono Italic"
font-family-bold-italic = "JetBrains Mono SemiBold Italic"
font-thicken = true
font-thicken-strength = 0
alpha-blending = native
font-size = 18
theme = light:"Catppuccin Latte",dark:"Catppuccin Frappe"
window-theme = system
background-opacity = 0.85
background-blur-radius = 30
shell-integration = zsh
keybind = global:alt+space=toggle_quick_terminal
window-inherit-working-directory = false
window-padding-balance = true
#window-padding-x = 0
#window-padding-y = 0
window-padding-color = extend

# macOS specific features
macos-titlebar-style = hidden
macos-option-as-alt = true 
macos-non-native-fullscreen = true
macos-auto-secure-input = true
macos-secure-input-indication = true
window-save-state = always
window-vsync = true
window-colorspace = display-p3
quick-terminal-screen = mouse
initial-window = false
